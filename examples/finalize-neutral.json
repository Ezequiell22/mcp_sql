{
  "contractVersion": "1.2",
  "contextId": "REPLACE_WITH_RETURNED_CONTEXT_ID",
  "sql": "SELECT c.id AS customer_id, c.name AS customer_name, SUM(o.net_total) AS revenue FROM public.orders AS o JOIN public.customers AS c ON c.id = o.customer_id WHERE o.ordered_on >= $1::date AND o.ordered_on < $2::date GROUP BY c.id, c.name ORDER BY c.id",
  "parameters": [
    {
      "position": 1,
      "name": "period_start",
      "nullable": false,
      "binding": {
        "filterId": "period",
        "field": "from"
      },
      "sqlType": "date"
    },
    {
      "position": 2,
      "name": "period_until",
      "nullable": false,
      "binding": {
        "filterId": "period",
        "field": "until"
      },
      "sqlType": "date"
    }
  ],
  "filters": [
    {
      "id": "period",
      "label": "Per\u00edodo dos pedidos",
      "kind": "date_range",
      "required": true,
      "fields": {
        "from": {
          "type": "date",
          "nullable": false,
          "parameterPosition": 1,
          "inclusive": true
        },
        "until": {
          "type": "date",
          "nullable": false,
          "parameterPosition": 2,
          "inclusive": false
        }
      },
      "validation": {
        "ordering": "from < until"
      }
    }
  ],
  "outputs": [
    {
      "key": "customer_id",
      "label": "Cliente"
    },
    {
      "key": "customer_name",
      "label": "Nome do cliente"
    },
    {
      "key": "revenue",
      "label": "Receita l\u00edquida",
      "sqlType": "numeric"
    }
  ],
  "semantics": {
    "grain": [
      "customer_id"
    ],
    "countedEntities": [],
    "measures": [
      {
        "outputKey": "revenue",
        "definition": "SUM of the approved order-level net_total measure."
      }
    ],
    "assumptions": [
      "Confirm net_total meaning, currency and cancellation rules with the data owner before adopting this example."
    ],
    "resolvedDecisions": []
  }
}
