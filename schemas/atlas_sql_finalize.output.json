                "resolvedDecisions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "grain",
                "countedEntities",
                "measures",
                "assumptions",
                "resolvedDecisions"
