                    "minLength": 1,
                    "maxLength": 128
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "postgresType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "logicalType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "nullable": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "lineage": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
