                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 10000
                },
                "functions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 1000
                },
                "metadataFingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "policyVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "relations",
                "columns",
                "functions",
                "metadataFingerprint",
                "policyVersion"
              ],
              "additionalProperties": false
            },
            "requiredSessionSettings": {
              "type": "object",
              "properties": {
                "search_path": {
                  "const": "pg_catalog"
                }
              },
              "required": [
                "search_path"
              ],
              "additionalProperties": false
            },
            "validation": {
              "type": "object",
              "properties": {
                "syntax": {
                  "const": "passed"
                },
                "resolution": {
                  "const": "passed_supported_subset"
                },
                "authorization": {
                  "const": "passed"
                },
                "readOnlyPolicy": {
                  "const": "passed"
                },
                "bindings": {
                  "const": "passed"
                },
                "semantics": {
                  "const": "declared_rules_only"
                },
                "executionPerformed": {
                  "const": false
                },
                "costAssessment": {
                  "const": "not_performed"
                },
                "businessEquivalence": {
                  "const": "not_proven"
                },
                "verifiedAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "contextExpiresAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "syntax",
                "resolution",
                "authorization",
                "readOnlyPolicy",
                "bindings",
                "semantics",
                "executionPerformed",
                "costAssessment",
                "businessEquivalence",
                "verifiedAt",
                "contextExpiresAt",
                "limitations"
              ],
              "additionalProperties": false
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
