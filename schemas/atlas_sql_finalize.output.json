                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 100
                },
                "countedEntities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
