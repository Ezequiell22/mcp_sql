          "required": [
            "contractVersion",
            "dialect",
            "postgresMajorVersion",
            "sql",
            "artifactHash",
            "parameters",
            "filters",
            "outputs",
            "semantics",
            "dependencies",
            "requiredSessionSettings",
            "validation",
            "warnings",
            "explanation"
          ],
          "additionalProperties": false
