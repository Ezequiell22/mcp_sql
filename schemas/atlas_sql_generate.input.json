{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 100
    }
  },
  "required": [
    "contractVersion",
    "connectionId",
    "request"
  ],
  "additionalProperties": false
}
