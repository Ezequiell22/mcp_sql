{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "postgresType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "nullable": {
            "type": "boolean"
          },
          "binding": {
            "type": "object",
            "properties": {
              "filterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "filterId",
              "field"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "position",
          "name",
          "postgresType",
          "nullable",
          "binding"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "text",
              "boolean",
              "integer",
              "decimal",
              "date",
              "timestamp",
              "enum",
              "array",
              "date_range",
              "number_range",
              "timestamp_range"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 2,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "boolean",
                    "integer",
                    "decimal",
                    "date",
                    "timestamp",
                    "enum",
                    "array"
                  ]
                },
                "parameterPosition": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "inclusive": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "minimum": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maximum": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "scale": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                "elementType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 100
                },
                "default": {
                  "type": [
                    "string",
                    "boolean",
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "boolean"
                    ]
                  },
                  "maxItems": 1000,
                  "maxLength": 16384
                }
              },
              "required": [
                "type",
                "parameterPosition",
                "nullable"
              ],
              "additionalProperties": false
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "ordering": {
                "enum": [
                  "from < until",
                  "from <= until"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "required",
          "fields"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "postgresType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "semantics": {
      "type": "object",
      "properties": {
        "grain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 100
        },
        "countedEntities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outputKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "definition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "outputKey",
              "definition"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100
        },
        "resolvedDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100
        }
      },
      "required": [
        "grain",
        "countedEntities",
        "measures",
        "assumptions",
        "resolvedDecisions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "contextId",
    "sql",
    "parameters",
    "filters",
    "outputs",
    "semantics"
  ],
  "additionalProperties": false
}
