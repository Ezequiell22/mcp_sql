{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "connected"
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dialect": {
          "enum": [
            "postgresql",
            "sqlserver"
          ]
        },
        "contractVersion": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relationCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "status",
        "connectionId",
        "dialect",
        "contractVersion",
        "expiresAt",
        "relationCount"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "fieldPath": {
              "type": "string",
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "fieldPath",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
